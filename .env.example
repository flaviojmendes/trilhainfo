# Para usar o backend da Trilha Info:
VITE_API_URL=https://api.trilha.info/api
VITE_PUBLIC_URL=https://api.trilha.info/public

# Se possuir o backend rodando localmente, descomente as variaveis abaixo
# VITE_API_URL=http://localhost:8000/api
# VITE_PUBLIC_URL=http://localhost:8000/public
# Sugestões de conteúdo (função /api/contributions na Vercel).
# Sem GITHUB_APP_ID, o envio funciona em modo de teste e não abre PR.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_INSTALLATION_ID=
# CONTRIBUTIONS_REPOSITORY=flaviojmendes/trilhainfo
# CONTRIBUTIONS_BASE_BRANCH=main
# Cloudflare Turnstile: obrigatório em produção.
# VITE_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
